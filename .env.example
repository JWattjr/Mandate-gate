# MandateGate targets GenLayer Studio Next only:
#   CLI network  studio-dev
#   GenLayerJS   studioDevnet (genlayer-js/chains)
#   RPC          https://studio-dev.genlayer.com/api
#   Chain ID     61997
# The RPC and chain come from the pinned genlayer-js studioDevnet definition; they are not configurable here.

# Optional: override the contract address baked in lib/deployment.json (written by `npm run deploy:contract`).
NEXT_PUBLIC_MANDATEGATE_ADDRESS=

# Optional: deployer key for scripts. If unset, scripts generate and reuse .keys/deployer.key (git-ignored).
# Never commit a real key. Studio Next GEN has no value; the scripts fund the key from the Studio faucet.
MANDATEGATE_DEPLOYER_KEY=

# Optional: after `npm run seed:demo`, hand contract ownership to this wallet so its owner-only
# Cancel control works in the UI. Equivalent later: npm run owner:transfer -- 0xYourAddress
MANDATEGATE_OWNER_ADDRESS=
